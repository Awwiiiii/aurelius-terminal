# =============================================================================
# AURELIUS — Environment Variable Template
# =============================================================================
# Instructions:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env to version control (.gitignore protects it)
#   4. .env.example IS committed — it documents what variables exist.
#
# Security:
#   API keys in .env are credentials. Treat them like passwords.
#   Do not share .env files via email, Slack, or public repositories.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Runtime environment: development | production
AURELIUS_ENV=development

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG to see provider request/response details during development.
# WARNING: DEBUG may log large API responses. Never use DEBUG in production.
AURELIUS_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------

# Host and port for the Uvicorn development server.
# 127.0.0.1 binds to localhost only (safe default).
# Use 0.0.0.0 only if you need LAN access from another device.
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated list of allowed CORS origins.
# Development: allow the Vite frontend dev server.
# Production: replace with your actual deployed frontend URL.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------------------------------------------------------------------------
# Data Provider API Keys
# ---------------------------------------------------------------------------
# These keys are sent to provider APIs by the BACKEND only.
# The frontend NEVER has access to these values.

# Financial Modeling Prep (FMP)
# Required from Milestone 6 (Financial Statements).
# Free tier: 250 requests/day. https://financialmodelingprep.com
# Leave blank if not yet obtained.
FMP_API_KEY=

# Alpha Vantage
# Optional alternative provider for historical price data.
# Free tier: 25 requests/day. https://www.alphavantage.co
# Leave blank if not yet obtained.
ALPHA_VANTAGE_API_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLAlchemy async connection URL.
#
# Development (SQLite, zero setup required):
DATABASE_URL=sqlite+aiosqlite:///./aurelius.db
#
# Production path (PostgreSQL — requires explicit schema and query
# compatibility testing; a simple URL swap is NOT sufficient):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aurelius
